# Commits and phase of the comparisons in go/compare, read by run_compare.sh. See go/compare/README.md.

# Reference: the previous step, compared exactly (phase 1) or statistically (phases 2 and 3). It moves at the end
# of each phase, and in phase 3 after each fix. Here the merge commit of step F0d, the last of the steps F0.
REFERENCE_COMMIT=6561b78

# Input format of the reference program: netlogo (the NetLogo files, -d and -p, output -f) or yaml (a run file of the
# current format, --config, output -o). The current code reads run files since step F7, gobees (BASE_COMMIT) the
# NetLogo files. Becomes yaml when the reference moves to a commit with the current run file format (key name,
# run.repetitions, output folder -o).
REFERENCE_INPUT=netlogo

# Base: gobees, compared statistically (drift) and timed (speed). Not the fork point 40dc301, but the gobees commit
# that writes the NetLogo metrics (obs.DailyOutput of gobees), same model. In this repository as the tag gobees-base.
# Stays fixed.
BASE_COMMIT=ff06b97

# Phase of the steps: 1 compares exactly with the reference. 2 and 3 compare statistically, because the steps
# change the random draws (2) or the results (3) on purpose.
PHASE=1

# Columns of the other versions that the current code removes on purpose, together with their model branch
# (space-separated). They are not compared. Without this list, a missing column is an error. gobees (BASE_COMMIT)
# keeps them, so the list only grows. TotalIBMColonies and ibm_colonies: individual-based colonies, removed in step F1.
REMOVED_COLUMNS='TotalIBMColonies ibm_colonies'
