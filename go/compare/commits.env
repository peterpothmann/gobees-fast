# Commits and phase of the comparisons in go/compare, read by run_compare.sh. See go/compare/README.md.

# Reference: the previous step, compared exactly (phase 1) or statistically (phases 2 and 3). It moves at the end
# of each phase, and in phase 3 after each fix. Until the steps F0 are merged it is the fork point (gobees), which
# writes only the 15 columns of DailyOutput. After the merge: set it to the merge commit, so that all columns are
# compared.
REFERENCE_COMMIT=40dc301

# Base: gobees, the fork point. Compared statistically (drift) and timed (speed). Stays fixed.
BASE_COMMIT=40dc301

# Phase of the steps: 1 compares exactly with the reference. 2 and 3 compare statistically, because the steps
# change the random draws (2) or the results (3) on purpose.
PHASE=1
